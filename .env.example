# ==============================================================================
# DrTech.Care Environment Configuration Template
# Copy this file to `.env.local` for local development:
#   cp .env.example .env.local
# NEVER commit `.env.local` or real secret keys to Git.
# ==============================================================================

# --- Runtime & Server ---
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
INTERNAL_EMAIL_DOMAIN=clinic.internal

# --- Network, Proxy & Security ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
TRUST_PROXY_HOPS=0
HOSPITAL_IPS=127.0.0.1,::1,localhost
IP_LOGIN_MAX_FAILURES=50
HOSPITAL_IP_LOGIN_MAX_FAILURES=200

# Development only: must be false (or unset) in production
ALLOW_INSECURE_COOKIES=true
ALLOW_BEARER_IN_PROD=false

# --- Secrets (generate 64-char hex via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))") ---
KIOSK_PAIRING_SECRET=replace-with-64-char-random-hex
AUTH_SECRET=replace-with-64-char-random-hex

# --- Supabase Cloud / Local Postgres ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
# Required in production and for full Cloud RLS admin writes (exercises, modpacks, etc.)
# Obtain from Supabase Dashboard -> Project Settings -> API -> service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Optional direct Postgres URL for scripts/run-migration.ts & scripts/calibrate-face.ts
# DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# --- Local Persistence Mode (Development only; forbidden in production) ---
# Set USE_LOCAL_STORAGE=true to persist all entities in data/local_db.json without Cloud service_role key
USE_LOCAL_STORAGE=false
STORAGE_HOST=

# --- Liveness / PAD & Privacy ---
PAD_MODE=active_only
PAD_PROVIDER=active_challenge_tracker
LOG_FACE_SCORES=false
ALLOW_KIOSK_SELF_ENROLL=false
LOGIN_SNAPSHOT_RETENTION=0

# --- Biometric Thresholds (Cosine Similarity Space: 0 < REJECT < ACCEPT < DUPLICATE <= 1.0) ---
FACE_T_ACCEPT=0.48
FACE_T_REJECT=0.40
FACE_T_MARGIN=0.05
FACE_T_ENROLL_CONSISTENCY=0.65
FACE_T_DUPLICATE=0.88
FACE_MIN_IOD=25
FACE_CHALLENGE_EXPIRE_SECONDS=60
