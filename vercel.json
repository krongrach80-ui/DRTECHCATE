{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install --include=dev",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api?__path=$1"
    },
    {
      "source": "/api",
      "destination": "/api"
    },
    {
      "source": "/admin/:path*",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/pt/:path*",
      "destination": "/pt/index.html"
    },
    {
      "source": "/pt",
      "destination": "/pt/index.html"
    },
    {
      "source": "/kiosk/:path*",
      "destination": "/kiosk/index.html"
    },
    {
      "source": "/kiosk",
      "destination": "/kiosk/index.html"
    },
    {
      "source": "/",
      "destination": "/kiosk/index.html"
    }
  ]
}
