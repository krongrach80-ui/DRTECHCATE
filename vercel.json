{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/admin/:path*",
      "destination": "/admin/index.html"
    },
    {
      "source": "/pt/:path*",
      "destination": "/pt/index.html"
    },
    {
      "source": "/kiosk/:path*",
      "destination": "/kiosk/index.html"
    }
  ]
}
