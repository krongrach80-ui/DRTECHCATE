{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "drtechcate",
  "main": "scripts/worker.js",
  "compatibility_date": "2024-09-23",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none",
    "html_handling": "auto-trailing-slash"
  }
}

