{
  "name": "drtechcare",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx apps/api/src/server.ts",
    "build": "npm run build:apps && npm run copy:apps",
    "build:types": "tsc -p tsconfig.build.json",
    "start": "tsx apps/api/src/server.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:rls": "tsx scripts/test-rls.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "db:migrate": "tsx scripts/run-migration.ts",
    "ci:bundle": "tsx scripts/check-bundle.ts",
    "dev:api": "tsx apps/api/src/server.ts",
    "dev:admin": "vite --config apps/admin/vite.config.ts --port 5173",
    "dev:pt": "vite --config apps/pt/vite.config.ts --port 5174",
    "dev:kiosk": "vite --config apps/kiosk/vite.config.ts --port 5175",
    "build:apps": "vite build apps/admin && vite build apps/pt && vite build apps/kiosk",
    "copy:apps": "tsx scripts/copy-apps.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "lucide-react": "^1.61.0",
    "multer": "^2.5.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "pg": "^8.23.1",
    "playwright": "^1.64.1",
    "supertest": "^7.3.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
